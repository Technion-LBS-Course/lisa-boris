# PyroFinder environment configuration
# Copy this file to .env and fill in values as needed.
# Never commit .env to Git.

PYROFINDER_ENV=development

# Paths
DATA_DIR=./data
MODEL_DIR=./models

# Model configuration
DEFAULT_MODEL_NAME=yolo11s
BASELINE_MODEL_NAME=yolo11n

# Detection settings
CONFIDENCE_THRESHOLD=0.5
CONFIRMATION_FRAMES=3

# Map defaults (Tel Aviv area as example — replace with actual site)
MAP_DEFAULT_LAT=32.0853
MAP_DEFAULT_LON=34.7818

# API keys — never commit real values. Prefer .streamlit/secrets.toml; env also works.
# GROQ_API_KEY=your-groq-key-here   # AI-assisted zone setup + optional wording polish (optional)
# The Risk Advisory uses Open-Meteo (https://open-meteo.com) and needs NO API key.
# It falls back to a deterministic offline mock if live weather is unavailable.
