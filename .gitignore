# Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment secrets — NEVER commit .env
.env
.env.*

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Data — large datasets stay outside Git; generated CSV is allowed
RAW_DATA/
data/*
!data/.gitkeep
!data/dfire_metadata.csv

# Model weights and training artifacts
models/
weights/
runs/
mlruns/
wandb/
*.pt
*.pth
*.onnx
*.weights
*.pkl
*.joblib

# Video files
*.mp4
*.avi
*.mov
*.mkv
*.webm

# Image files — samples belong in data/, not root
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.bmp
*.gif

# Exception: committed sample images + labels for fresh-clone demo
!data/samples/
!data/samples/**

# Exception: market-survey competitor screenshots (after the *.png rule so it wins)
!data/market-survey/
!data/market-survey/**

# Exception: Live Ops demo assets — committed so the public Streamlit Cloud app runs
# the Live demo on a fresh clone (lightweight extracted frames + reference frame).
# Re-include the directory first, then its contents (a parent dir excluded by
# `data/*` cannot otherwise be re-included). The large raw source video is
# re-ignored last so it never gets committed. Runtime data/live_events.jsonl stays
# ignored via the earlier `data/*` rule.
!data/live_demo/
!data/live_demo/**
data/live_demo/*.mp4
data/live_demo/*.mov
data/live_demo/*.avi
data/live_demo/*.mkv

# Exception: Live Ops operational context (landmarks / contacts / policy) — committed
# so the public Streamlit Cloud app has incident context on a fresh clone.
!data/live_ops/
!data/live_ops/**

# Exception: UI design assets used by the Streamlit app
!design_images/
!design_images/DANI_PERSONA.png
!design_images/User_Journey_before.png
!design_images/User_Journey_after.png
!design_images/Nordic_Forest_LowPolymp_.mp4

# Streamlit
.streamlit/secrets.toml

# Archives
*.zip
*.tar.gz

# Logs and temp
*.log

# Build / distribution
dist/
build/
*.egg-info/

# Exception: the two small fine-tuned D-Fire checkpoints are committed so the
# public Streamlit Cloud app (https://pyrofinder.streamlit.app/) can run inference
# on a fresh clone (~24 MB total, well under GitHub's 100 MB/file limit). All other
# weights / *.pt files stay ignored. These rules come last so they win over the
# earlier `models/` and `*.pt` excludes (last matching pattern wins).
!models/
models/*
!models/yolo11n_dfire_best.pt
!models/yolo11s_dfire_best.pt
